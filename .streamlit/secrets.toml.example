# Mẫu cấu hình bí mật. KHÔNG đưa file secrets.toml thật lên GitHub.
#
# - Chạy trên máy: chép file này thành .streamlit/secrets.toml rồi sửa giá trị.
# - Streamlit Cloud: vào app → Settings → Secrets, dán 3 dòng bên dưới vào.
#
# Khi chưa có tài khoản nào, app tự tạo tài khoản quản trị này.
# Nếu bỏ trống, lần đầu mở app sẽ hiện màn hình "Tạo tài khoản quản trị".

[auth]
admin_username = "quanly"
admin_password = "doi-mat-khau-nay"
