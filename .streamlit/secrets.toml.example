# Mẫu cấu hình bí mật. KHÔNG đưa file secrets.toml thật lên GitHub.
#
# - Chạy trên máy: chép file này thành .streamlit/secrets.toml rồi sửa giá trị.
# - Streamlit Cloud: vào app → Settings → Secrets, dán nội dung bên dưới vào.
#
# Mỗi lần khởi động, app tự tạo các tài khoản dưới đây nếu chưa có
# (tài khoản đã có thì giữ nguyên, không ghi đè mật khẩu đã đổi).
# Nếu không khai báo quản trị viên, lần đầu mở app sẽ hiện màn hình "Tạo tài khoản quản trị".

[auth]
admin_username = "quanly"
admin_password = "doi-mat-khau-nay"

# Tài khoản quản lý kho (ghi phiếu, kiểm kê cho danh mục được giao, được chấm KPI)
[auth.managers]
"nhan vien 1" = "doi-mat-khau-nay"
"nhan vien 2" = "doi-mat-khau-nay"
"nhan vien 3" = "doi-mat-khau-nay"

# (Tùy chọn) Tài khoản chỉ xem
# [auth.staff]
# "ke toan" = "doi-mat-khau-nay"

# (Tùy chọn) Phân công người quản lý: "tên tài khoản" = ["Danh mục", ...]
# Chỉ gán những danh mục chưa có người; đổi lại được trong app.
[auth.assign]
"nhan vien 1" = ["Sữa & đồ uống", "Thực phẩm tươi"]
"nhan vien 2" = ["Lương thực", "Đồ khô"]
"nhan vien 3" = ["Gia vị", "Dầu ăn"]
